{
  "name": "all-purposes-file-converter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.js --outfile public/dist/app.js --format=esm --minify",
    "serve": "bun server/index.js",
    "start": "bun run build && bun run serve",
    "test": "bun tests/make-fixtures.mjs && bun tests/smoke.mjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright-core": "^1.64.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "turndown": "^7.2.4"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
